# Postgres. `pnpm db:up` starts one with these credentials.
DATABASE_URL=postgres://squadai:squadai@localhost:5432/squadai

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Encrypts provider API keys at rest (32 bytes, base64).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SQUADAI_MASTER_KEY=

# Optional: sign in with GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: how long the demo model waits per answer, so you can watch the room update (ms).
SQUADAI_DEMO_DELAY_MS=1200

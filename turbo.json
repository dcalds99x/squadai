{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "SCREENSHOT_URL",
    "SCREENSHOT_LOCALE",
    "SCREENSHOT_BROWSER",
    "SCREENSHOT_EXECUTABLE"
  ]
}
